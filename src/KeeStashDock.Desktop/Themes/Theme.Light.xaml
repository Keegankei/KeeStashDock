<!-- Light theme palette. Every visual color in the app is a DynamicResource
     pointing at one of these keys, so ThemeManager can swap Light/Dark at
     runtime by replacing this dictionary (no window restart).
     The accent is dark enough for white-on-accent controls to pass AA. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="C.Accent">#3E6BA8</Color>

  <SolidColorBrush x:Key="B.WindowBg"    Color="#F5F6F8"/>
  <SolidColorBrush x:Key="B.PanelBg"     Color="#F6FFFFFF"/>
  <SolidColorBrush x:Key="B.CardBg"      Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.CardHover"   Color="#E9EFF9"/>
  <SolidColorBrush x:Key="B.Border"      Color="#D5DAE2"/>
  <SolidColorBrush x:Key="B.TextPrimary" Color="#191C21"/>
  <SolidColorBrush x:Key="B.TextMuted"   Color="#5C6470"/>
  <SolidColorBrush x:Key="B.Accent"      Color="#3E6BA8"/>
  <SolidColorBrush x:Key="B.AccentSoft"  Color="#283E6BA8"/>
  <SolidColorBrush x:Key="B.OnAccent"    Color="#FFFFFF"/>
  <!-- Card-scoped text keys for auto-contrast: identical to
       TextPrimary/TextMuted by default; the quick panel overrides them
       separately from the chrome text because a translucent card over a
       wallpaper can need the OPPOSITE scheme from bare panel text. -->
  <SolidColorBrush x:Key="B.CardTextPrimary" Color="#191C21"/>
  <SolidColorBrush x:Key="B.CardTextMuted"   Color="#5C6470"/>
  <!-- Input-surface text keys for auto-contrast: text in
       the quick-input box and the combos sits on B.InputBg, which the panel
       renders translucently - so it gets its own light/dark decision, like
       cards do. Defaults match TextPrimary/TextMuted. -->
  <SolidColorBrush x:Key="B.InputText"      Color="#191C21"/>
  <SolidColorBrush x:Key="B.InputTextMuted" Color="#5C6470"/>
  <SolidColorBrush x:Key="B.InputBg"     Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.Danger"      Color="#C6413C"/>
</ResourceDictionary>
