<!-- Shared control styles. Theme-agnostic: all colors come from the active
     Theme.*.xaml palette via DynamicResource. Includes the composite font
     fallback chain covering the 10 launch languages. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Typography.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Font fallback chain (design item: 10-language coverage):
       Segoe UI Variable (Latin/Cyrillic/Greek, Win11) -> Segoe UI (incl. Arabic
       shaping) -> Microsoft YaHei UI (Simplified Chinese) -> Microsoft JhengHei UI
       (Traditional Chinese) -> Yu Gothic UI (Japanese). WPF walks the list per
       glyph, so mixed-script snippets render correctly in one TextBlock. -->
  <FontFamily x:Key="F.UI">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft JhengHei UI, Yu Gothic UI</FontFamily>
  <FontFamily x:Key="F.Mono">Cascadia Code, Consolas, Microsoft YaHei UI</FontFamily>

  <!-- Base text -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}"/>
  </Style>

  <!-- Code-built controls without an explicit visual style still inherit the global text size. -->
  <Style TargetType="Button">
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
  </Style>
  <Style TargetType="Label">
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
  </Style>
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource B.Link}"/>
  </Style>

  <!-- Rounded input box -->
  <Style x:Key="S.Input" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.InputText}"/>
    <Setter Property="Background" Value="{DynamicResource B.InputBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource B.Accent}"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- IME note: DIB rendering keeps the composition window
         anchored correctly inside borderless popups for CJK IMEs. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource B.Focus}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Flat rounded button -->
  <Style x:Key="S.Button" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource B.AccentSoft}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary (accent) button. Foreground comes from the theme (B.OnAccent):
       dark text on the bright dark-theme accent, white on the light accent. -->
  <Style x:Key="S.ButtonPrimary" TargetType="Button" BasedOn="{StaticResource S.Button}">
    <Setter Property="Background" Value="{DynamicResource B.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
  </Style>

  <!-- Small square icon button for the panel top bar.
       ContentTemplate carries an EXPLICIT MDL2 TextBlock: the app-wide
       implicit TextBlock style would otherwise replace the icon font with
       the UI font chain and the glyph would render as nothing. -->
  <Style x:Key="S.IconButton" TargetType="Button" BasedOn="{StaticResource S.Button}">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                     Foreground="{Binding Foreground,
                                  RelativeSource={RelativeSource AncestorType=Button}}"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Snippet card container -->
  <Style x:Key="S.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource B.CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="10"/>
    <Setter Property="Margin" Value="8,4"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.10"/>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource B.CardHover}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Type badge chip -->
  <Style x:Key="S.Badge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="5,1"/>
  </Style>

  <!-- ============ Themed stock controls ================================
       These implicit styles replace the light system chrome of ComboBox,
       ContextMenu/MenuItem, ToolTip, CheckBox and ScrollBar so the dark
       palette is consistent everywhere, not just on custom-styled parts. -->

  <!-- Explicit list styles keep data lists on the active palette without
       replacing the specialized navigation and quick-panel card templates. -->
  <Style x:Key="S.ListItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource B.InputText}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="ListItemFace" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground"
                          Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource B.CardHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="{DynamicResource B.AccentSoft}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="S.List" TargetType="ListBox">
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Background" Value="{DynamicResource B.InputBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.InputText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource S.ListItem}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border x:Name="ListFace" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ScrollViewer x:Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ListFace" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource B.CardBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="8,5">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource B.CardBg}"
                  BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                  CornerRadius="8" Padding="4">
            <ItemsPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Flat menu items (the app only uses single-level menus). -->
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}"/>
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="12,7">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bg" Property="Background"
                      Value="{DynamicResource B.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{DynamicResource B.Border}" Margin="8,4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource B.InputText}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bg" Background="Transparent" CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <!-- String content is rendered by an auto-generated TextBlock;
                 the APP-level implicit TextBlock style pins it to
                 B.TextPrimary (the CHROME key), which is wrong on the
                 translucent input surface. A closer-scoped implicit style
                 wins the lookup and reroutes it to the input-surface key. -->
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                  <Setter Property="Foreground"
                          Value="{DynamicResource B.InputText}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bg" Property="Background"
                      Value="{DynamicResource B.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bg" Property="Background"
                      Value="{DynamicResource B.AccentSoft}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource F.UI}"/>
    <Setter Property="FontSize" Value="{DynamicResource T.Font12}"/>
    <Setter Property="Foreground" Value="{DynamicResource B.InputText}"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="{DynamicResource B.InputBg}"
                          BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                          CornerRadius="8">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource B.InputTextMuted}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush"
                              Value="{DynamicResource B.Accent}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
              <!-- Same reroute as in ComboBoxItem: the selection box shows a
                   generated TextBlock whose color must follow the INPUT
                   surface, not the panel chrome. -->
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                  <Setter Property="Foreground"
                          Value="{DynamicResource B.InputText}"/>
                  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                   StaysOpen="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{DynamicResource B.CardBg}"
                      BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                      CornerRadius="8" Margin="0,4,0,0" Padding="4"
                      MinWidth="{Binding ActualWidth,
                                 RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim themed scrollbars (thumb-only; track click still pages). -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                              Focusable="False"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                              Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource B.ScrollThumb}"
                              CornerRadius="4" Margin="1"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"
                                  Focusable="False"/>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"
                                  Focusable="False"/>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="{DynamicResource B.ScrollThumb}"
                                  CornerRadius="4" Margin="1"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
