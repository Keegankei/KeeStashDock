<Window xmlns:loc="clr-namespace:KeeStashDock.Desktop.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KeeStashDock.Desktop.Views.SettingsWindow" Title="{loc:Tr Settings.Title}" Width="960" Height="780" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen" Background="{DynamicResource B.WindowBg}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="S.Button" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource B.InputBg}" />
      <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="{DynamicResource T.Font12}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="S.ComponentButton" TargetType="Button" BasedOn="{StaticResource S.Button}" />
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
      <Setter Property="FontSize" Value="{DynamicResource T.Font13}" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="Margin" Value="0,3,0,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="FocusBorder" Padding="{TemplateBinding Padding}" BorderThickness="1" CornerRadius="7" BorderBrush="Transparent" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Margin="0,0,18,0" VerticalAlignment="Center" RecognizesAccessKey="True">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource B.TextMuted}" Background="{DynamicResource B.InputBg}" VerticalAlignment="Center">
                  <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3" HorizontalAlignment="Left" Fill="{DynamicResource B.TextMuted}" />
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.Accent}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource B.OnAccent}" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="FocusBorder" Property="Background" Value="{DynamicResource B.AccentSoft}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="FocusBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="S.Section" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource B.SettingsSurfaceBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22,20" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="S.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource T.Font15}" />
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="S.Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="{DynamicResource T.Font12}" />
      <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="{DynamicResource T.Line19}" />
    </Style>
    <Style x:Key="S.RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style x:Key="S.RowValue" TargetType="TextBlock" BasedOn="{StaticResource S.Caption}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="MinWidth" Value="42" />
    </Style>
    <Style x:Key="S.Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="S.NavigationItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,14" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="NavFace" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavFace" Property="Background" Value="{DynamicResource B.CardHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavFace" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="NavFace" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="S.TranslationPassword" TargetType="PasswordBox">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="{DynamicResource B.InputBg}" />
      <Setter Property="Foreground" Value="{DynamicResource B.InputText}" />
      <Setter Property="CaretBrush" Value="{DynamicResource B.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource B.Border}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Border x:Name="SliderFocus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="3,0">
              <Track x:Name="PART_Track" VerticalAlignment="Center" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Accent}" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="22">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource B.CardBg}" Stroke="{DynamicResource B.Accent}" StrokeThickness="3" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Border}" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SliderFocus" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SliderFocus" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="208" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="SettingsNavigationSurface" Background="{DynamicResource B.SettingsSurfaceBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0">
      <Grid Margin="14,30,14,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="14,0,6,28">
          <TextBlock x:Name="SettingsBrandText" Text="KeeStashDock" FontSize="{DynamicResource T.Font20}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="KeeStashDock" />
          <TextBlock Text="{loc:Tr Settings.Title}" Style="{StaticResource S.Caption}" Margin="0,6,0,0" />
        </StackPanel>
        <ListBox x:Name="SettingsNavigation" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource S.NavigationItem}" SelectionChanged="OnSettingsNavigationChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBoxItem Tag="General">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Settings.Nav.General}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem Tag="Translation">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Settings.Nav.Translation}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem Tag="Appearance">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Settings.Nav.Appearance}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem Tag="Components">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Settings.Nav.Components}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem Tag="Data">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Settings.Nav.Data}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
          </ListBoxItem>
          <ListBoxItem Tag="About">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <TextBlock Grid.Column="1" Text="{loc:Tr Settings.Nav.About}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
          </ListBoxItem>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="14,16,6,0">
          <TextBlock x:Name="SettingsVersionText" FontWeight="SemiBold" FontSize="{DynamicResource T.Font12}" />
          <TextBlock Text="{loc:Tr Settings.SavedAutomatically}" Style="{StaticResource S.Caption}" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="SettingsPageHost" Grid.Column="1" Margin="32,30,24,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,10,24">
        <TextBlock x:Name="SettingsPageTitle" FontSize="{DynamicResource T.Font29}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SettingsPageDescription" Style="{StaticResource S.Caption}" Margin="0,9,0,0" />
      </StackPanel>
      <TextBlock x:Name="FolderStatus" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource B.Accent}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Padding="0,0,8,16" x:Name="GeneralPage">
        <StackPanel>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Startup}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}" Margin="8,0,0,0" Click="OnReloadLocaleClick" Content="{loc:Tr Settings.ReloadLocale}" ToolTip="{loc:Tr Settings.ReloadLocale.Tip}" />
                <ComboBox x:Name="LangCombo" SelectionChanged="OnLanguageChanged" DisplayMemberPath="NativeName" HorizontalAlignment="Stretch" />
              </DockPanel>
              <CheckBox x:Name="AutoStartCheck" Margin="0,3,0,10" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged" Foreground="{DynamicResource B.TextPrimary}" Content="{loc:Tr Settings.AutoStart}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}" x:Name="HotkeysSection">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Hotkey}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <TextBlock Text="{loc:Tr Settings.Hotkey.Hint}" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap" />
              <TextBox x:Name="HotkeyBox" Style="{StaticResource S.Input}" IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="OnHotkeyRecord" />
              <TextBlock x:Name="HotkeyStatus" FontSize="{DynamicResource T.Font12}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.TextMuted}" />
              <CheckBox x:Name="ScreenshotHotkeyCheck" Margin="0,3,0,10" Checked="OnScreenshotHotkeyEnabledChanged" Unchecked="OnScreenshotHotkeyEnabledChanged">
                <TextBlock Text="{loc:Tr Screenshot.HotkeyEnabled}" TextWrapping="Wrap" />
              </CheckBox>
              <StackPanel x:Name="ScreenshotHotkeyEditor">
                <TextBlock Text="{loc:Tr Screenshot.HotkeyHint}" FontSize="{DynamicResource T.Font12}" TextWrapping="Wrap" Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,6" />
                <TextBox x:Name="ScreenshotHotkeyBox" Style="{StaticResource S.Input}" IsReadOnly="True" IsReadOnlyCaretVisible="False" PreviewKeyDown="OnScreenshotHotkeyRecord" />
              </StackPanel>
              <TextBlock x:Name="ScreenshotHotkeyStatus" FontSize="{DynamicResource T.Font12}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.TextMuted}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Collection}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <CheckBox x:Name="ClipboardWatchCheck" Margin="0,3,0,10" Checked="OnCollectionChanged" Unchecked="OnCollectionChanged" Content="{loc:Tr Settings.ClipboardWatch}" />
              <CheckBox x:Name="DirectPasteCheck" Margin="0,3,0,10" Checked="OnCollectionChanged" Unchecked="OnCollectionChanged" Content="{loc:Tr Settings.DirectPaste}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.PanelBehavior}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <CheckBox x:Name="PanelEdgeAutoHideCheck" Margin="0,3,0,10" Content="{loc:Tr Settings.Panel.EdgeAutoHide}" Checked="OnPanelEdgeAutoHideChanged" Unchecked="OnPanelEdgeAutoHideChanged" />
              <TextBlock Text="{loc:Tr Settings.Panel.EdgeAutoHideHint}" TextWrapping="Wrap" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,10" />
              <Grid Style="{StaticResource S.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220" TextWrapping="Wrap" Text="{loc:Tr Settings.Panel.CollapseDelay}" HorizontalAlignment="Left" />
                <TextBox Grid.Column="1" x:Name="CollapseDelayBox" Style="{StaticResource S.Input}" Width="70" Padding="8,4" HorizontalAlignment="Left" HorizontalContentAlignment="Center" LostFocus="OnDelayChanged" KeyDown="OnDelayKeyDown" />
              </Grid>
              <Grid Margin="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220" TextWrapping="Wrap" Text="{loc:Tr Settings.Panel.ExpandDelay}" HorizontalAlignment="Left" />
                <TextBox Grid.Column="1" x:Name="ExpandDelayBox" Style="{StaticResource S.Input}" Width="70" Padding="8,4" HorizontalAlignment="Left" HorizontalContentAlignment="Center" LostFocus="OnDelayChanged" KeyDown="OnDelayKeyDown" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Padding="0,0,8,16" x:Name="TranslationPage">
        <StackPanel>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.SelectionBubble}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <CheckBox x:Name="SelectionPopupCheck" Margin="0,3,0,10" Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" Content="{loc:Tr Settings.EnableSelectionBubble}" />
              <Grid Style="{StaticResource S.Row}" x:Name="SelectionActionRow">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220" TextWrapping="Wrap" Text="{loc:Tr Settings.SelectionAction}" HorizontalAlignment="Left" />
                <ComboBox Grid.Column="1" x:Name="SelectionActionCombo" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionActionChanged">
                  <ComboBoxItem Tag="Capture" Content="{loc:Tr Settings.SelectionAction.Capture}" />
                  <ComboBoxItem Tag="Translate" Content="{loc:Tr Settings.SelectionAction.Translate}" />
                  <ComboBoxItem Tag="Both" Content="{loc:Tr Settings.SelectionAction.Both}" />
                </ComboBox>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.ResultOptions}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <StackPanel>
                <CheckBox x:Name="ResultTargetCheck" Content="{loc:Tr Settings.ResultShowTargetSelector}" Checked="OnResultOptionsChanged" Unchecked="OnResultOptionsChanged" Margin="0,3,0,10" />
                <CheckBox x:Name="ResultSaveCheck" Content="{loc:Tr Settings.ResultShowSavePanel}" Checked="OnResultOptionsChanged" Unchecked="OnResultOptionsChanged" Margin="0,3,0,10" />
                <TextBlock Text="{loc:Tr Settings.ResultOptionsHint}" Style="{StaticResource S.Caption}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.TranslateEngine}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <Grid x:Name="TranslateEngineRow" Style="{StaticResource S.Row}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox Grid.Row="1" x:Name="TranslateEngineCombo" HorizontalAlignment="Stretch" SelectionChanged="OnTranslateEngineChanged">
                  <ComboBoxItem Tag="Bing" Content="{loc:Tr Settings.TranslateEngine.Bing}" />
                  <ComboBoxItem Tag="Baidu" Content="{loc:Tr Settings.TranslateEngine.Baidu}" />
                  <ComboBoxItem Tag="Aliyun" Content="{loc:Tr Settings.TranslateEngine.Aliyun}" />
                  <ComboBoxItem Tag="Offline" Content="{loc:Tr Settings.TranslateEngine.Offline}" />
                  <ComboBoxItem Tag="Google" Content="Google" />
                  <ComboBoxItem Tag="Lingva" Content="Lingva" />
                  <ComboBoxItem Tag="DeepL" Content="DeepL" />
                </ComboBox>
              </Grid>
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{loc:Tr Settings.TranslationTarget}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ComboBox x:Name="TranslationTargetCombo" HorizontalAlignment="Stretch" SelectionChanged="OnTranslationTargetChanged" />
                <TextBlock x:Name="TranslationTargetStatus" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}" />
                <TextBlock Text="{loc:Tr Settings.TranslationTargetHint}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}" />
              </StackPanel>
              <TextBlock x:Name="TranslateEngineHint" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}" Text="{loc:Tr Settings.TranslateEngine.Hint}" />
              <Grid x:Name="TranslationAppIdRow" Style="{StaticResource S.Row}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220" TextWrapping="Wrap" Text="{loc:Tr Settings.TranslationAppId}" HorizontalAlignment="Left" />
                <TextBox Grid.Column="1" x:Name="TranslationAppIdBox" Style="{StaticResource S.Input}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextChanged="OnTranslationAppIdChanged" />
              </Grid>
