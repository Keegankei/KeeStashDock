                  <Button Style="{StaticResource S.Button}" Tag="Offline" Click="OnResetFolderClick" Content="{loc:Tr Settings.Paths.Reset}" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock Text="{loc:Tr Settings.Paths.ComponentHint}" Style="{StaticResource S.Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <StackPanel x:Name="ComponentOperationPanel">
            <ProgressBar x:Name="ComponentProgress" IsIndeterminate="True" Height="4" Margin="0,8,0,6" Visibility="Collapsed" Background="{DynamicResource B.InputBg}" Foreground="{DynamicResource B.Accent}" BorderBrush="{DynamicResource B.Border}" />
            <TextBlock x:Name="ComponentOperationStatus" TextWrapping="Wrap" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}" />
            <TextBox x:Name="ComponentDiagnostic" Style="{StaticResource S.Input}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed" />
            <Button x:Name="ComponentCancelButton" Style="{StaticResource S.ComponentButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" Click="OnCancelComponentClick" Content="{loc:Tr Common.Cancel}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Padding="0,0,8,16" x:Name="DataPage">
        <StackPanel>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <CheckBox x:Name="AutoBackupCheck" Margin="0,3,0,10" Checked="OnAutoBackupChanged" Unchecked="OnAutoBackupChanged" Content="{loc:Tr Settings.AutoBackup}" FontWeight="SemiBold" />
              <StackPanel x:Name="BackupScheduleOptions">
                <Grid Style="{StaticResource S.Row}" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220" TextWrapping="Wrap" Text="{loc:Tr Settings.AutoBackup.Interval}" HorizontalAlignment="Left" />
                  <ComboBox Grid.Column="1" x:Name="AutoBackupIntervalCombo" HorizontalAlignment="Stretch" SelectionChanged="OnAutoBackupChanged">
                    <ComboBoxItem Tag="15" Content="15 min" />
                    <ComboBoxItem Tag="30" Content="30 min" />
                    <ComboBoxItem Tag="60" Content="1 h" />
                    <ComboBoxItem Tag="360" Content="6 h" />
                    <ComboBoxItem Tag="720" Content="12 h" />
                    <ComboBoxItem Tag="1440" Content="24 h" />
                    <ComboBoxItem Tag="2880" Content="48 h" />
                    <ComboBoxItem Tag="10080" Content="7 d" />
                  </ComboBox>
                </Grid>
                <Grid Style="{StaticResource S.Row}" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220" TextWrapping="Wrap" Text="{loc:Tr Settings.Backup.KeepCount}" HorizontalAlignment="Left" />
                  <ComboBox Grid.Column="1" x:Name="BackupKeepCountCombo" HorizontalAlignment="Stretch" SelectionChanged="OnBackupKeepCountChanged">
                    <ComboBoxItem Tag="7" Content="7" />
                    <ComboBoxItem Tag="30" Content="30" />
                    <ComboBoxItem Tag="100" Content="100" />
                  </ComboBox>
                </Grid>
                <TextBlock x:Name="BackupRetentionText" TextWrapping="Wrap" Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,8" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Paths.Backup}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <StackPanel Margin="0">
                <TextBox x:Name="BackupPathText" IsReadOnly="True" Style="{StaticResource S.Input}" Margin="0,6,0,10" TextWrapping="Wrap" />
                <WrapPanel x:Name="BackupPathActions">
                  <Button Style="{StaticResource S.Button}" Tag="Backup" Click="OnChooseFolderClick" Content="{loc:Tr Settings.Paths.Choose}" Margin="0,0,8,6" />
                  <Button Style="{StaticResource S.Button}" Tag="Backup" Click="OnOpenFolderClick" Content="{loc:Tr Settings.Paths.Open}" Margin="0,0,8,6" />
                  <Button Style="{StaticResource S.Button}" Tag="Backup" Click="OnResetFolderClick" Content="{loc:Tr Settings.Paths.Reset}" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock Text="{loc:Tr Settings.Paths.BackupHint}" Style="{StaticResource S.Caption}" Margin="0,4,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Backup.Snapshots}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <TextBlock Text="{loc:Tr Settings.Backup.Scope}" TextWrapping="Wrap" Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,8" />
              <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
              <WrapPanel Margin="0,0,0,8">
                <Button x:Name="BackupNowButton" Style="{StaticResource S.Button}" Margin="0,0,8,8" Click="OnBackupNowClick" Content="{loc:Tr Settings.Backup.Now}" />
                <Button Style="{StaticResource S.Button}" Margin="0,0,8,8" Click="OnOpenBackupFolderClick" Content="{loc:Tr Settings.Backup.OpenFolder}" />
                <Button Style="{StaticResource S.Button}" Margin="0,0,0,8" Click="OnRefreshBackupsClick" Content="{loc:Tr Settings.Backup.Refresh}" />
              </WrapPanel>
              <ListBox x:Name="BackupSnapshotList" Style="{StaticResource S.List}" MaxHeight="150" MinHeight="44" DisplayMemberPath="DisplayName" SelectionChanged="OnBackupSelectionChanged" AutomationProperties.Name="{loc:Tr Settings.Backup.Snapshots}" />
              <Button x:Name="RestoreBackupButton" Style="{StaticResource S.Button}" HorizontalAlignment="Left" Margin="0,8,0,12" IsEnabled="False" Click="OnRestoreBackupClick" Content="{loc:Tr Settings.Backup.RestoreSelected}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Data}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <StackPanel>
                <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="OnExportClick" Content="{loc:Tr Settings.Backup.Export}" />
                <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="OnImportClick" Content="{loc:Tr Settings.Backup.Import}" />
                <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" x:Name="RestartButton" Click="OnRestartClick" Content="{loc:Tr Settings.Restart}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Padding="0,0,8,16" x:Name="AboutPage">
        <StackPanel>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.About}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <TextBlock x:Name="AboutText" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}" TextWrapping="Wrap" />
              <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnCheckUpdatesClick" Content="{loc:Tr Updates.Check}" />
              <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnHelpClick" Content="{loc:Tr Settings.Help}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource S.Section}">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Paths.Data}" TextWrapping="Wrap" Style="{StaticResource S.SectionTitle}" />
              <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Style="{StaticResource S.Caption}" />
              <TextBlock Text="{loc:Tr Settings.Paths.DataHint}" TextWrapping="Wrap" Style="{StaticResource S.Caption}" />
              <Button Style="{StaticResource S.Button}" Tag="Data" Click="OnOpenFolderClick" HorizontalAlignment="Left" Margin="0,14,0,0" Content="{loc:Tr Settings.Paths.Open}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
