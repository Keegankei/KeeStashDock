<!-- Settings: language (hot switch), global hotkey recorder with conflict
     detection, autostart, theme, backup export/import, about.
     Every logical group sits in its own rounded section
     card; label/control rows share one aligned grid per card, so the page
     reads as a tidy form instead of a raw stack of controls. -->
<Window x:Class="KeeStashDock.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeeStashDock.Desktop.Localization"
        Title="{loc:Tr Settings.Title}"
        Width="560" Height="660" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.WindowBg}">

  <Window.Resources>
    <Style x:Key="S.TranslationPassword" TargetType="PasswordBox">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Background" Value="{DynamicResource B.InputBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource B.InputText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource B.Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="S.ComponentButton" TargetType="Button" BasedOn="{StaticResource S.Button}">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Section card -->
    <Style x:Key="S.Section" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource B.CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="S.SectionTitle" TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="S.RowLabel" TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="S.RowValue" TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="42"/>
      <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}"/>
    </Style>
    <!-- Aligned setting row: col 0 shares ONE width across every section
         (SharedSizeGroup), so all labels, combos and sliders line up on the
         same vertical axis page-wide - the "designed" look. -->
    <Style x:Key="S.Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18,16" Grid.IsSharedSizeScope="True">

      <!-- ============ Language ============ -->
      <Border Style="{StaticResource S.Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}"
                     Text="{loc:Tr Settings.Language}"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource S.Button}"
                    Margin="8,0,0,0" Click="OnReloadLocaleClick"
                    Content="{loc:Tr Settings.ReloadLocale}"
                    ToolTip="{loc:Tr Settings.ReloadLocale.Tip}"/>
            <ComboBox x:Name="LangCombo" SelectionChanged="OnLanguageChanged"
                      DisplayMemberPath="NativeName"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- ============ Hotkey ============ -->
      <Border Style="{StaticResource S.Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}"
                     Text="{loc:Tr Settings.Hotkey}"/>
          <TextBlock Text="{loc:Tr Settings.Hotkey.Hint}" FontSize="11"
                     Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,6"/>
          <TextBox x:Name="HotkeyBox" Style="{StaticResource S.Input}"
                   IsReadOnly="True" IsReadOnlyCaretVisible="False"
                   PreviewKeyDown="OnHotkeyRecord"/>
          <TextBlock x:Name="HotkeyStatus" FontSize="11" Margin="0,4,0,0"
                     Foreground="{DynamicResource B.Danger}" Visibility="Collapsed"
                     Text="{loc:Tr Settings.Hotkey.Conflict}"/>
          <CheckBox x:Name="ScreenshotHotkeyCheck" Margin="0,14,0,6"
                    Checked="OnScreenshotHotkeyEnabledChanged" Unchecked="OnScreenshotHotkeyEnabledChanged">
            <TextBlock Text="{loc:Tr Screenshot.HotkeyEnabled}" TextWrapping="Wrap"/>
          </CheckBox>
          <TextBlock Text="{loc:Tr Screenshot.HotkeyHint}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,6"/>
          <TextBox x:Name="ScreenshotHotkeyBox" Style="{StaticResource S.Input}"
                   IsReadOnly="True" IsReadOnlyCaretVisible="False"
                   PreviewKeyDown="OnScreenshotHotkeyRecord"/>
          <TextBlock x:Name="ScreenshotHotkeyStatus" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource B.Danger}" Visibility="Collapsed"
                     Text="{loc:Tr Screenshot.HotkeyConflict}"/>
        </StackPanel>
      </Border>

      <!-- ============ Optional local components ============ -->
      <Border Style="{StaticResource S.Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}" Text="{loc:Tr Components.Title}"/>
          <TextBlock Text="{loc:Tr Components.Hint}" TextWrapping="Wrap" FontSize="11"
                     Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,12"/>
          <TextBlock Text="{loc:Tr Components.Ocr}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="OcrComponentStatus" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource B.TextMuted}" Margin="0,4,0,6"/>
          <Button x:Name="OcrSetupButton" Style="{StaticResource S.ComponentButton}" HorizontalAlignment="Left"
                  Background="{DynamicResource B.AccentSoft}" Click="OnOcrSetupClick">
            <TextBlock Text="{loc:Tr Components.Install}" TextWrapping="Wrap"/>
          </Button>
          <TextBlock Text="{loc:Tr Components.Offline}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0"/>
          <TextBlock x:Name="OfflineComponentStatus" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource B.TextMuted}" Margin="0,4,0,6"/>
          <WrapPanel>
            <Button x:Name="OfflineSetupButton" Style="{StaticResource S.ComponentButton}" Margin="0,0,8,6"
                    Background="{DynamicResource B.AccentSoft}" Click="OnOfflineSetupClick">
              <TextBlock Text="{loc:Tr Components.Install}" TextWrapping="Wrap"/>
            </Button>
            <Button x:Name="OfflineStartButton" Style="{StaticResource S.ComponentButton}" Margin="0,0,8,6" Click="OnOfflineStartClick">
              <TextBlock Text="{loc:Tr Components.Start}" TextWrapping="Wrap"/>
            </Button>
            <Button x:Name="OfflineStopButton" Style="{StaticResource S.ComponentButton}" Margin="0,0,0,6" Click="OnOfflineStopClick">
              <TextBlock Text="{loc:Tr Components.Stop}" TextWrapping="Wrap"/>
            </Button>
          </WrapPanel>
          <ProgressBar x:Name="ComponentProgress" IsIndeterminate="True" Height="4" Margin="0,8,0,6" Visibility="Collapsed"/>
          <TextBlock x:Name="ComponentOperationStatus" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource B.TextMuted}"/>
          <TextBox x:Name="ComponentDiagnostic" Style="{StaticResource S.Input}" IsReadOnly="True" TextWrapping="Wrap"
                   MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed"/>
          <Button x:Name="ComponentCancelButton" Style="{StaticResource S.ComponentButton}" HorizontalAlignment="Left"
                  Margin="0,8,0,0" Visibility="Collapsed" Click="OnCancelComponentClick" Content="{loc:Tr Common.Cancel}"/>
        </StackPanel>
      </Border>

      <!-- ============ Behavior ============ -->
      <Border Style="{StaticResource S.Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}"
                     Text="{loc:Tr Settings.Behavior}"/>
          <CheckBox x:Name="AutoStartCheck" Margin="0,0,0,6"
                    Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"
                    Foreground="{DynamicResource B.TextPrimary}"
                    Content="{loc:Tr Settings.AutoStart}"/>
          <CheckBox x:Name="SelectionPopupCheck" Margin="0,0,0,8"
                    Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged"
                    Content="{loc:Tr Settings.SelectionPopup}"/>

          <!-- Bubble action: capture OR translate, exactly one. Indented
               under - and locked with - the bubble toggle above. -->
          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.SelectionAction}"/>
            <ComboBox Grid.Column="1" x:Name="SelectionActionCombo" MaxWidth="200"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnSelectionActionChanged">
              <ComboBoxItem Tag="Capture"
                            Content="{loc:Tr Settings.SelectionAction.Capture}"/>
              <ComboBoxItem Tag="Translate"
                            Content="{loc:Tr Settings.SelectionAction.Translate}"/>
            </ComboBox>
          </Grid>

          <!-- Translation controls are shown while the action is Translate. -->
          <Grid x:Name="TranslateEngineRow" Style="{StaticResource S.Row}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.TranslateEngine}"/>
            <ComboBox Grid.Row="1" x:Name="TranslateEngineCombo"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnTranslateEngineChanged">
              <ComboBoxItem Tag="Bing" Content="{loc:Tr Settings.TranslateEngine.Bing}"/>
              <ComboBoxItem Tag="Baidu" Content="{loc:Tr Settings.TranslateEngine.Baidu}"/>
              <ComboBoxItem Tag="Aliyun" Content="{loc:Tr Settings.TranslateEngine.Aliyun}"/>
              <ComboBoxItem Tag="Offline" Content="{loc:Tr Settings.TranslateEngine.Offline}"/>
              <ComboBoxItem Tag="Google" Content="Google"/>
              <ComboBoxItem Tag="Lingva" Content="Lingva"/>
              <ComboBoxItem Tag="DeepL"  Content="DeepL"/>
            </ComboBox>
          </Grid>

          <TextBlock x:Name="TranslateEngineHint" Margin="0,0,0,10"
                     TextWrapping="Wrap" FontSize="11"
                     Foreground="{DynamicResource B.TextMuted}"
                     Text="{loc:Tr Settings.TranslateEngine.Hint}"/>

          <Grid x:Name="TranslationAppIdRow" Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap" Text="{loc:Tr Settings.TranslationAppId}"/>
            <TextBox Grid.Column="1" x:Name="TranslationAppIdBox" Width="260" Style="{StaticResource S.Input}"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     TextChanged="OnTranslationAppIdChanged"/>
          </Grid>

          <!-- Credential values are stored separately for each provider. -->
          <Grid x:Name="ApiKeyRow" Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.ApiKey}"/>
            <TextBox Grid.Column="1" x:Name="ApiKeyBox" Width="260" Style="{StaticResource S.Input}"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     TextChanged="OnApiKeyChanged"/>
          </Grid>

          <StackPanel x:Name="AliyunSettingsPanel" Margin="0,0,0,10">
            <TextBlock Text="{loc:Tr Settings.AliyunHint}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,10"/>
            <TextBlock Text="{loc:Tr Settings.AliyunAccessKeyId}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBox x:Name="AliyunAccessKeyIdBox" Style="{StaticResource S.Input}"
                     TextChanged="OnAliyunCredentialsChanged" Margin="0,0,0,10"/>
            <TextBlock Text="{loc:Tr Settings.AliyunAccessKeySecret}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <PasswordBox x:Name="AliyunAccessKeySecretBox" Style="{StaticResource S.TranslationPassword}"
                         PasswordChanged="OnAliyunSecretChanged"/>
          </StackPanel>

          <StackPanel x:Name="OfflineSettingsPanel" Margin="0,0,0,10">
            <TextBlock Text="{loc:Tr Settings.OfflineHint}" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource B.TextMuted}" Margin="0,0,0,10"/>
            <TextBlock Text="{loc:Tr Settings.OfflineEndpoint}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBox x:Name="OfflineEndpointBox" Style="{StaticResource S.Input}"
                     TextChanged="OnOfflineEndpointChanged" Margin="0,0,0,8"/>
          </StackPanel>

          <StackPanel x:Name="TranslationTestPanel" Margin="0,0,0,12">
            <Button x:Name="TranslationTestButton" Style="{StaticResource S.Button}"
                    Background="{DynamicResource B.AccentSoft}" Click="OnTranslationTestClick" HorizontalAlignment="Left">
              <TextBlock Text="{loc:Tr Settings.TranslationTest}" TextWrapping="Wrap"/>
            </Button>
            <TextBlock x:Name="TranslationTestStatus" TextWrapping="Wrap" Margin="0,6,0,0"
                       FontSize="11" Foreground="{DynamicResource B.TextMuted}"/>
          </StackPanel>

          <!-- Bubble dress: classic accent pill or theme-following glass.
               Locked together with the bubble toggle, like the action. -->
          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.BubbleStyle}"/>
            <ComboBox Grid.Column="1" x:Name="BubbleStyleCombo" MaxWidth="200"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnBubbleStyleChanged">
              <ComboBoxItem Tag="Default"
                            Content="{loc:Tr Settings.BubbleStyle.Default}"/>
              <ComboBoxItem Tag="FollowTheme"
                            Content="{loc:Tr Settings.BubbleStyle.FollowTheme}"/>
              <!-- Palette pins: glass in one fixed palette, independent of
                   the panel's text-color setting (labels reused from it). -->
              <ComboBoxItem Tag="Ivory"    Content="{loc:Tr Settings.PanelTextColor.Ivory}"/>
              <ComboBoxItem Tag="Graphite" Content="{loc:Tr Settings.PanelTextColor.Graphite}"/>
              <ComboBoxItem Tag="Amber"    Content="{loc:Tr Settings.PanelTextColor.Amber}"/>
              <ComboBoxItem Tag="Mint"     Content="{loc:Tr Settings.PanelTextColor.Mint}"/>
              <ComboBoxItem Tag="Sky"      Content="{loc:Tr Settings.PanelTextColor.Sky}"/>
              <ComboBoxItem Tag="Rose"     Content="{loc:Tr Settings.PanelTextColor.Rose}"/>
              <ComboBoxItem Tag="Lavender" Content="{loc:Tr Settings.PanelTextColor.Lavender}"/>
              <ComboBoxItem Tag="Coral"    Content="{loc:Tr Settings.PanelTextColor.Coral}"/>
              <ComboBoxItem Tag="Teal"     Content="{loc:Tr Settings.PanelTextColor.Teal}"/>
              <ComboBoxItem Tag="Slate"    Content="{loc:Tr Settings.PanelTextColor.Slate}"/>
            </ComboBox>
          </Grid>

          <!-- Bubble EFFECT toggles: the glow halo under the text and the
               lift shadow under the glass, each independently switchable.
               Indented to read as children of the bubble master switch and
               locked/dimmed together with it. -->
          <CheckBox x:Name="BubbleGlowCheck" Margin="22,0,0,6"
                    Checked="OnBubbleFxChanged" Unchecked="OnBubbleFxChanged"
                    Content="{loc:Tr Settings.BubbleGlow}"/>
          <CheckBox x:Name="BubbleShadowCheck" Margin="22,0,0,8"
                    Checked="OnBubbleFxChanged" Unchecked="OnBubbleFxChanged"
                    Content="{loc:Tr Settings.BubbleShadow}"/>

          <!-- Bubble opacity: the cure for "the desktop bleeds through the
               bubble" - 100% turns the glass fully opaque. -->
          <Grid Style="{StaticResource S.Row}" Margin="22,0,12,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.BubbleOpacity}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Slider x:Name="BubbleOpacitySlider" Width="200" Minimum="50" Maximum="100"
                      VerticalAlignment="Center" IsSnapToTickEnabled="True"
                      TickFrequency="5" ValueChanged="OnBubbleOpacityChanged"/>
              <TextBlock x:Name="BubbleOpacityValue" Style="{StaticResource S.RowValue}"/>
            </StackPanel>
          </Grid>

          <!-- Clipboard history collection: opt-IN (privacy decision). The
               single switch IS the pause - off means off, instantly. -->
          <CheckBox x:Name="ClipboardWatchCheck" Margin="0,4,0,8"
                    Checked="OnCollectionChanged" Unchecked="OnCollectionChanged"
                    Content="{loc:Tr Settings.ClipboardWatch}"/>

          <!-- Direct paste: card click also lands a Ctrl+V in the window
               the user came from (opt-in). -->
          <CheckBox x:Name="DirectPasteCheck" Margin="0,0,0,8"
                    Checked="OnCollectionChanged" Unchecked="OnCollectionChanged"
                    Content="{loc:Tr Settings.DirectPaste}"/>

          <!-- Panel timing: seconds, committed on focus loss / Enter -->
          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.Panel.CollapseDelay}"/>
            <TextBox Grid.Column="1" x:Name="CollapseDelayBox"
                     Style="{StaticResource S.Input}" Width="70" Padding="8,4"
                     HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                     LostFocus="OnDelayChanged" KeyDown="OnDelayKeyDown"/>
          </Grid>
          <Grid Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.Panel.ExpandDelay}"/>
            <TextBox Grid.Column="1" x:Name="ExpandDelayBox"
                     Style="{StaticResource S.Input}" Width="70" Padding="8,4"
                     HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                     LostFocus="OnDelayChanged" KeyDown="OnDelayKeyDown"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ Appearance ============
           Every row is label-column + control-column; the label column
           shares its width page-wide (SharedSizeGroup) so controls align. -->
      <Border Style="{StaticResource S.Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}"
                     Text="{loc:Tr Settings.Theme}"/>

          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}"
                       Text="{loc:Tr Settings.Theme}"/>
            <ComboBox Grid.Column="1" x:Name="ThemeCombo" Width="200"
                      HorizontalAlignment="Left"
                      SelectionChanged="OnThemeChanged">
              <ComboBoxItem Tag="System" Content="{loc:Tr Settings.Theme.System}"/>
              <ComboBoxItem Tag="Light"  Content="{loc:Tr Settings.Theme.Light}"/>
              <ComboBoxItem Tag="Dark"   Content="{loc:Tr Settings.Theme.Dark}"/>
            </ComboBox>
          </Grid>

          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.PanelTextColor}"/>
            <ComboBox Grid.Column="1" x:Name="TextColorCombo" Width="200"
                      HorizontalAlignment="Left"
                      SelectionChanged="OnTextColorChanged">
              <ComboBoxItem Tag="Auto"     Content="{loc:Tr Settings.PanelTextColor.Auto}"/>
              <ComboBoxItem Tag="Ivory"    Content="{loc:Tr Settings.PanelTextColor.Ivory}"/>
              <ComboBoxItem Tag="Graphite" Content="{loc:Tr Settings.PanelTextColor.Graphite}"/>
              <ComboBoxItem Tag="Amber"    Content="{loc:Tr Settings.PanelTextColor.Amber}"/>
              <ComboBoxItem Tag="Mint"     Content="{loc:Tr Settings.PanelTextColor.Mint}"/>
              <ComboBoxItem Tag="Sky"      Content="{loc:Tr Settings.PanelTextColor.Sky}"/>
              <ComboBoxItem Tag="Rose"     Content="{loc:Tr Settings.PanelTextColor.Rose}"/>
              <ComboBoxItem Tag="Lavender" Content="{loc:Tr Settings.PanelTextColor.Lavender}"/>
              <ComboBoxItem Tag="Coral"    Content="{loc:Tr Settings.PanelTextColor.Coral}"/>
              <ComboBoxItem Tag="Teal"     Content="{loc:Tr Settings.PanelTextColor.Teal}"/>
              <ComboBoxItem Tag="Slate"    Content="{loc:Tr Settings.PanelTextColor.Slate}"/>
              <ComboBoxItem Tag="Custom"   Content="{loc:Tr Settings.PanelTextColor.Custom}"/>
            </ComboBox>
          </Grid>

          <!-- Custom color editor: hex + standard RGB picker + live swatch.
               Aligned under the combo (label column left empty), locked and
               dimmed unless the Custom scheme is active. -->
          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" x:Name="CustomColorRow"
                        Orientation="Horizontal">
              <TextBox x:Name="CustomColorBox" Style="{StaticResource S.Input}"
                       Width="96" Padding="8,4"
                       HorizontalContentAlignment="Center" ToolTip="#RRGGBB"
                       LostFocus="OnCustomColorChanged"
                       KeyDown="OnCustomColorKeyDown"/>
              <Button Style="{StaticResource S.Button}"
                      Margin="8,0,0,0" Padding="10,5"
                      Click="OnPickColorClick" ToolTip="RGB">
                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets"
                           FontSize="13"/>
              </Button>
              <Border x:Name="CustomColorSwatch" Width="24" Height="24"
                      Margin="8,0,0,0" CornerRadius="6"
                      VerticalAlignment="Center"
                      BorderBrush="{DynamicResource B.Border}"
                      BorderThickness="1"/>
            </StackPanel>
          </Grid>

          <Grid Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.CardOpacity}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Slider x:Name="CardOpacitySlider" Width="200" Minimum="10" Maximum="100"
                      VerticalAlignment="Center" IsSnapToTickEnabled="True"
                      TickFrequency="5" ValueChanged="OnEffectsChanged"/>
              <TextBlock x:Name="CardOpacityValue" Style="{StaticResource S.RowValue}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ============ Background image (quick panel only) ============ -->
      <Border Style="{StaticResource S.Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}"
                     Text="{loc:Tr Settings.Bg}"/>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource S.Button}" Click="OnPickBgClick"
                    Content="{loc:Tr Settings.Bg.Select}"/>
            <Button Style="{StaticResource S.Button}" Margin="8,0,0,0"
                    Click="OnClearBgClick" Content="{loc:Tr Settings.Bg.Clear}"/>
          </StackPanel>
          <TextBlock x:Name="BgPathText" FontSize="11" Margin="0,6,0,12"
                     Foreground="{DynamicResource B.TextMuted}"
                     TextTrimming="CharacterEllipsis"/>

          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}"
                       Text="{loc:Tr Settings.Bg.Opacity}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Slider x:Name="BgOpacitySlider" Width="200" Minimum="0" Maximum="100"
                      VerticalAlignment="Center" IsSnapToTickEnabled="True"
                      TickFrequency="5" ValueChanged="OnBgOpacityChanged"/>
              <TextBlock x:Name="BgOpacityValue" Style="{StaticResource S.RowValue}"/>
            </StackPanel>
          </Grid>

          <!-- Frosted glass: blurs the background IMAGE under the content -->
          <Grid Style="{StaticResource S.Row}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="FrostCheck" VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      Checked="OnEffectsChanged" Unchecked="OnEffectsChanged"
                      Content="{loc:Tr Settings.Frost}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Slider x:Name="FrostSlider" Width="200" Minimum="1" Maximum="18"
                      VerticalAlignment="Center"
                      IsSnapToTickEnabled="True" TickFrequency="1"
                      ValueChanged="OnEffectsChanged"/>
              <TextBlock x:Name="FrostValue" Style="{StaticResource S.RowValue}"/>
            </StackPanel>
          </Grid>

        </StackPanel>
      </Border>

      <!-- ============ Data ============ -->
      <Border Style="{StaticResource S.Section}">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}"
                     Text="{loc:Tr Settings.Data}"/>
          <!-- One action per line reads as a checklist; each button hugs
               its own text (no shared width), all flush left. -->
          <CheckBox x:Name="AutoBackupCheck" Margin="0,0,0,6"
                    Checked="OnAutoBackupChanged" Unchecked="OnAutoBackupChanged"
                    Content="{loc:Tr Settings.AutoBackup}"/>
          <Grid Style="{StaticResource S.Row}" Margin="22,0,12,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource S.RowLabel}" MaxWidth="220"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings.AutoBackup.Interval}"/>
            <!-- Interval options are unit literals ("6 h") - language-neutral. -->
            <ComboBox Grid.Column="1" x:Name="AutoBackupIntervalCombo" Width="120"
                      HorizontalAlignment="Left"
                      SelectionChanged="OnAutoBackupChanged">
              <ComboBoxItem Tag="6"   Content="6 h"/>
              <ComboBoxItem Tag="12"  Content="12 h"/>
              <ComboBoxItem Tag="24"  Content="24 h"/>
              <ComboBoxItem Tag="48"  Content="48 h"/>
              <ComboBoxItem Tag="168" Content="7 d"/>
            </ComboBox>
          </Grid>
          <StackPanel>
            <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left"
                    Margin="0,0,0,8" Click="OnExportClick"
                    Content="{loc:Tr Settings.Backup.Export}"/>
            <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left"
                    Margin="0,0,0,8" Click="OnImportClick"
                    Content="{loc:Tr Settings.Backup.Import}"/>
            <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left"
                    x:Name="RestartButton" Click="OnRestartClick" Content="{loc:Tr Settings.Restart}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============ About ============ -->
      <Border Style="{StaticResource S.Section}" Margin="0">
        <StackPanel>
          <TextBlock Style="{StaticResource S.SectionTitle}"
                     Text="{loc:Tr Settings.About}"/>
          <TextBlock x:Name="AboutText" FontSize="12"
                     Foreground="{DynamicResource B.TextMuted}" TextWrapping="Wrap"/>
          <Button Style="{StaticResource S.Button}" HorizontalAlignment="Left"
                  Margin="0,10,0,0" Click="OnHelpClick"
                  Content="{loc:Tr Settings.Help}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
