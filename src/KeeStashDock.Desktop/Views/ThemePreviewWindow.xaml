<Window x:Class="KeeStashDock.Desktop.Views.ThemePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeeStashDock.Desktop.Localization"
        Title="{loc:Tr Theme.Preview}" Width="760" Height="780" MinWidth="420" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource B.WindowBg}"
        FontFamily="{StaticResource F.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/ThemePreviewStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="PreviewRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource B.CardBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,0,1">
      <Grid Margin="24,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource B.AccentSoft}"
                Margin="0,2,16,0" VerticalAlignment="Top">
          <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource B.Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="PreviewName" FontSize="{DynamicResource T.Font24}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="PreviewDescription" Style="{StaticResource S.Preview.Caption}" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,20">
      <StackPanel>
        <Border x:Name="PreviewImageFrame" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource B.Border}"
                Background="{DynamicResource B.CardBg}" Margin="0,0,0,18">
          <Image x:Name="PreviewImage" Height="218" Stretch="UniformToFill" SizeChanged="OnImageSizeChanged"
                 FlowDirection="LeftToRight" AutomationProperties.Name="{loc:Tr Theme.Preview}"/>
        </Border>
        <Grid x:Name="PreviewCards" SizeChanged="OnCardsSizeChanged">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="PreviewOptionsCard" Style="{StaticResource S.Preview.Card}" Margin="0,0,9,0">
            <StackPanel>
              <TextBlock Text="{loc:Tr Settings.Nav.Appearance}" Style="{StaticResource S.Preview.Title}" Margin="0,0,0,14"/>
              <TextBlock x:Name="PreviewModeLabel" Text="{loc:Tr Settings.Theme}" Style="{StaticResource S.Preview.Caption}" Margin="0,0,0,6"/>
              <ComboBox x:Name="PreviewModeCombo" HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{Binding ElementName=PreviewModeLabel}">
                <ComboBoxItem Tag="System" Content="{loc:Tr Settings.Theme.System}"/>
                <ComboBoxItem Tag="Light" Content="{loc:Tr Settings.Theme.Light}"/>
                <ComboBoxItem Tag="Dark" Content="{loc:Tr Settings.Theme.Dark}"/>
              </ComboBox>
              <Border Height="1" Background="{DynamicResource B.Border}" Margin="0,16,0,8"/>
              <CheckBox x:Name="PreviewBubbleCheck" Content="{loc:Tr Theme.ApplyBubbles}" IsChecked="True" Style="{StaticResource S.Preview.Switch}"/>
              <CheckBox x:Name="PreviewInstallCopyCheck" Content="{loc:Tr Theme.InstallCopy}" Style="{StaticResource S.Preview.Switch}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
          <Border x:Name="PreviewSampleCard" Grid.Column="1" Style="{StaticResource S.Preview.Card}" Margin="9,0,0,0">
            <StackPanel>
              <TextBlock Text="{loc:Tr Theme.Sample}" Style="{StaticResource S.Preview.Title}"/>
              <TextBox x:Name="PreviewSampleInput" Text="{loc:Tr Theme.SampleInput}" IsReadOnly="True" TextWrapping="Wrap"
                       Style="{StaticResource S.Input}" Margin="0,14,0,12" VerticalScrollBarVisibility="Auto"/>
              <Button x:Name="PreviewSampleButton" Content="{loc:Tr Theme.SampleButton}" HorizontalAlignment="Left"
                      MaxWidth="220" Style="{StaticResource S.Workbench.PrimaryButton}" Padding="14,9"/>
              <WrapPanel Margin="0,16,0,0" IsHitTestVisible="False" FlowDirection="LeftToRight">
                <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource B.Accent}" Margin="0,0,8,0"/>
                <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource B.AccentSoft}" Margin="0,0,8,0"/>
                <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource B.InputBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Margin="0,0,8,0"/>
                <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource B.TextMuted}" Margin="0,0,8,0"/>
                <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource B.TextPrimary}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
        <Border Background="{DynamicResource B.CardBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                CornerRadius="12" Padding="14,12" Margin="0,18,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,2,10,0" Foreground="{DynamicResource B.Accent}"/>
            <TextBlock x:Name="PreviewHint" Grid.Column="1" Style="{StaticResource S.Preview.Caption}"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border x:Name="PreviewFooter" Grid.Row="2" Background="{DynamicResource B.CardBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,0">
      <StackPanel Margin="24,14,24,8">
        <TextBlock x:Name="PreviewError" Foreground="{DynamicResource B.Danger}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="PreviewCancelButton" Content="{loc:Tr Theme.Cancel}" IsCancel="True" MinWidth="100" MaxWidth="220"
                  Style="{StaticResource S.Workbench.Button}" Padding="18,10" Margin="0,0,10,6" Click="OnCancelClick"/>
          <Button x:Name="PreviewApplyButton" MinWidth="120" MaxWidth="240" Style="{StaticResource S.Workbench.PrimaryButton}"
                  Padding="18,10" Margin="0,0,0,6" Click="OnApplyClick"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
