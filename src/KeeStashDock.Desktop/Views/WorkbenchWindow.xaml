<Window x:Class="KeeStashDock.Desktop.Views.WorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeeStashDock.Desktop.Localization"
        xmlns:v="clr-namespace:KeeStashDock.Desktop.Views"
        Title="{loc:Tr Workbench.Title}" Width="1120" Height="740" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource B.WindowBg}"
        FontFamily="{StaticResource F.UI}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/WorkbenchStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis"/>
      <v:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <!-- Navigation follows Settings; group commands stay anchored below the scrollable list. -->
    <Border Background="{DynamicResource B.CardBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,0,1,0">
      <Grid Margin="12,28,12,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,24">
          <TextBlock Text="KeeStashDock" FontSize="{DynamicResource T.Font19}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="KeeStashDock"/>
          <TextBlock Text="{loc:Tr Workbench.Library}" Style="{StaticResource S.Workbench.Caption}" Margin="0,6,0,0"/>
        </StackPanel>
        <!-- Category menus remain code-built to avoid BAML handler ids inside templates. -->
        <ListBox x:Name="NavList" Grid.Row="1" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource S.Workbench.NavigationItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseRightButtonUp="OnNavRightClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Name}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
          <Border Height="1" Background="{DynamicResource B.Border}" Margin="4,0,4,14"/>
          <Button Style="{StaticResource S.Workbench.Button}" Command="{Binding AddCategoryCommand}"
                  HorizontalAlignment="Stretch" Content="{loc:Tr Workbench.AddCategory}"/>
          <Button Style="{StaticResource S.Workbench.Button}" Margin="0,6,0,0" Click="OnImportGroupClick"
                  HorizontalAlignment="Stretch" Content="{loc:Tr Workbench.Category.Import}"/>
          <Button x:Name="PresetsBtn" Style="{StaticResource S.Workbench.Button}" Margin="0,6,0,0" Click="OnPresetsClick"
                  HorizontalAlignment="Stretch" Content="{loc:Tr Workbench.Category.Presets}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="20,24,20,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <Border DockPanel.Dock="Right" Background="{DynamicResource B.AccentSoft}" CornerRadius="8"
                  Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Items.Count}" Foreground="{DynamicResource B.Accent}" FontSize="{DynamicResource T.Font12}" FontWeight="SemiBold"/>
          </Border>
          <TextBlock Text="{Binding SelectedNav.Name}" FontSize="{DynamicResource T.Font23}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding SelectedNav.Name}" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="NewSnippetButton" Style="{StaticResource S.Workbench.PrimaryButton}"
                  Command="{Binding NewSnippetCommand}" Content="{loc:Tr Workbench.NewSnippet}"/>
          <Button x:Name="NewTemplateButton" Style="{StaticResource S.Workbench.Button}" Width="38" Padding="0" Margin="8,0,0,0"
                  Command="{Binding NewTemplateCommand}" ToolTip="{loc:Tr Template.New}" AutomationProperties.Name="{loc:Tr Template.New}">
            <TextBlock Text="{}{ }" FontFamily="{StaticResource F.Mono}" FontSize="16" FontWeight="SemiBold"/>
          </Button>
          <Button x:Name="CaptureButton" Style="{StaticResource S.Workbench.Button}" Width="38" Padding="0" Margin="8,0,0,0"
                  Click="OnCaptureScreenshot" ToolTip="{loc:Tr Screenshot.Capture}" AutomationProperties.Name="{loc:Tr Screenshot.Capture}">
            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
          </Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Padding="10,8" Margin="0,0,0,12" CornerRadius="10" Background="{DynamicResource B.AccentSoft}"
              Visibility="{Binding ShowBatchBar, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="{Binding BatchSelectionLabel}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"/>
            <Button x:Name="BatchActionsButton" Style="{StaticResource S.Workbench.Button}" Content="{loc:Tr Batch.Organize}"
                    Margin="0,0,6,0" Click="OnBatchActionsClick" IsEnabled="{Binding HasBatchSelection}"/>
            <Button Style="{StaticResource S.Workbench.Button}" Content="{loc:Tr Batch.Clear}" Margin="0,0,6,0" Click="OnClearBatchSelection"/>
            <Button Style="{StaticResource S.Workbench.Button}" Content="{loc:Tr Batch.Undo}" Command="{Binding UndoBatchCommand}"
                    Visibility="{Binding CanUndoBatch, Converter={StaticResource BoolToVis}}"/>
          </WrapPanel>
          <TextBlock Text="{Binding BatchStatus}" TextWrapping="Wrap" Foreground="{DynamicResource B.TextMuted}" FontSize="{DynamicResource T.Font11}"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.85*" MinWidth="228"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.15*" MinWidth="280"/>
        </Grid.ColumnDefinitions>
        <!-- Keep cards virtualized, without animated effects or per-card drop shadows. -->
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,4,10">
          <Grid>
            <TextBox x:Name="SearchBox" Style="{StaticResource S.Input}" Padding="34,11,10,11"
                     AutomationProperties.Name="{loc:Tr Workbench.Search.Placeholder}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="12,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False"/>
            <TextBlock Text="{loc:Tr Workbench.Search.Placeholder}" Margin="35,0,12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.InputTextMuted}" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="WorkbenchKindFilter" SelectedIndex="{Binding FilterKindIndex}" FontSize="{DynamicResource T.Font11}"
                      AutomationProperties.Name="{loc:Tr Search.Type}">
              <ComboBoxItem Content="{loc:Tr Search.Type.All}"/><ComboBoxItem Content="{loc:Tr Search.Type.Text}"/>
              <ComboBoxItem Content="{loc:Tr Search.Type.Image}"/><ComboBoxItem Content="{loc:Tr Search.Type.Template}"/>
            </ComboBox>
            <Grid Grid.Column="1" Margin="6,0,0,0">
            <TextBox x:Name="WorkbenchTagFilter" Style="{StaticResource S.Input}" Padding="8,4"
                     Text="{Binding FilterTag, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                     ToolTip="{loc:Tr Search.Tag}" AutomationProperties.Name="{loc:Tr Search.Tag}"/>
            <TextBlock Text="{loc:Tr Search.Tag}" Margin="9,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource B.InputTextMuted}" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=WorkbenchTagFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
            </Grid>
          </Grid>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{loc:Tr Workbench.Search.Results}" Margin="2,0,0,10">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource S.Workbench.Caption}">
                <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ListBox x:Name="ItemList" Grid.Row="2" ItemsSource="{Binding Items}"
                   SelectionMode="Extended" SelectionChanged="OnItemSelectionChanged" PreviewKeyDown="OnWorkbenchListKeyDown"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ItemContainerStyle="{StaticResource S.Workbench.SnippetItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                   VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <CheckBox x:Name="BatchItemCheck" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                              PreviewMouseDown="OnBatchCheckboxPreviewDown" ToolTip="{loc:Tr Batch.Select}" AutomationProperties.Name="{loc:Tr Batch.Select}"/>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource B.Accent}" Margin="8,0,0,0" VerticalAlignment="Center"
                               ToolTip="{loc:Tr Workbench.Editor.Heading}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Margin="8,0,0,0" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center"
                               ToolTip="{loc:Tr Workbench.Pinned}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="{DynamicResource T.Font14}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <Border Background="{DynamicResource B.InputBg}" CornerRadius="8" Padding="6" Margin="0,10,0,2"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding Thumbnail}" Height="92" Stretch="Uniform"/>
                  </Border>
                  <TextBlock Text="{Binding Preview}" Style="{StaticResource S.Workbench.Caption}" Margin="0,7,0,12" MaxHeight="{DynamicResource T.Length54}" TextTrimming="CharacterEllipsis"/>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RelativeTime}" FontSize="{DynamicResource T.Font11}" Margin="8,0,0,0"
                               Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource B.InputBg}" CornerRadius="5" Padding="6,3" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding TypeBadge}" FontSize="{DynamicResource T.Font10}" Foreground="{DynamicResource B.Accent}"/>
                    </Border>
                  </DockPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border x:Name="EmptyState" Grid.Row="2" Padding="18" Margin="0,0,4,0" CornerRadius="14"
                  Background="{DynamicResource B.CardBg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource B.Accent}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
              <TextBlock Text="{loc:Tr Workbench.Empty.Heading}" FontSize="{DynamicResource T.Font15}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock Text="{loc:Tr Workbench.Empty.Hint}" Style="{StaticResource S.Workbench.Caption}" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="3" Margin="0,6,4,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource S.Workbench.Button}" Command="{Binding LoadMoreCommand}"
                    Content="{loc:Tr Search.LoadMore}" Visibility="{Binding HasMoreResults, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ResultCountLabel}" Style="{StaticResource S.Workbench.Caption}" VerticalAlignment="Center"/>
          </DockPanel>
          <Button x:Name="EmptyTrashButton" Style="{StaticResource S.Workbench.Button}" Margin="0,6,0,0"
                  Foreground="{DynamicResource B.Danger}" Command="{Binding EmptyTrashCommand}" Content="{loc:Tr Workbench.EmptyTrash}"
                  Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </Grid>
        <!-- The editor stays editable when a search hides an unsaved draft. -->
        <ScrollViewer x:Name="EditorViewport" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border x:Name="EditorPane" Height="{Binding ActualHeight, ElementName=EditorViewport}" MinHeight="{DynamicResource T.EditorMinHeight}"
                CornerRadius="16" Background="{DynamicResource B.CardBg}"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="18">
          <DockPanel LastChildFill="True">
            <TextBlock x:Name="EditorHeading" DockPanel.Dock="Top" Text="{loc:Tr Workbench.Editor.Heading}" FontSize="{DynamicResource T.Font17}" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <ScrollViewer x:Name="MetadataViewport" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          FontSize="{DynamicResource T.Font13}" Margin="0,0,0,12">
              <StackPanel>
                <CheckBox x:Name="TemplateCheck" Content="{loc:Tr Template.Mark}" IsChecked="{Binding EditIsTemplate}"
                          IsEnabled="{Binding CanUseTemplate}" Margin="0,0,0,12"/>
                <Button x:Name="OpenImageButton" Style="{StaticResource S.Workbench.Button}" Click="OnOpenImage" Margin="0,0,0,12"
                        Visibility="{Binding SelectedItem.IsImage, Converter={StaticResource BoolToVis}}">
                  <StackPanel>
                    <Image Source="{Binding SelectedItem.Thumbnail}" Height="72" Stretch="Uniform"/>
                    <TextBlock Text="{loc:Tr Screenshot.Open}" HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Button>
                <TextBlock Text="{loc:Tr Workbench.Editor.TitlePlaceholder}" Style="{StaticResource S.Workbench.Caption}" Margin="0,0,0,6"/>
                <TextBox x:Name="TitleEditor" Style="{StaticResource S.Input}" FontSize="{DynamicResource T.Font14}" Padding="11,9" FontWeight="SemiBold"
                         AutomationProperties.Name="{loc:Tr Workbench.Editor.TitlePlaceholder}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{loc:Tr Expire.Label}" Style="{StaticResource S.Workbench.Caption}" Margin="0,0,0,6"/>
                  <TextBlock Grid.Column="2" Text="{loc:Tr Workbench.Tags}" Style="{StaticResource S.Workbench.Caption}" Margin="0,0,0,6"/>
                  <ComboBox x:Name="EditorExpiry" Grid.Row="1" FontSize="{DynamicResource T.Font12}" MinHeight="34" SelectedIndex="{Binding EditExpireIndex}"
                            ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{loc:Tr Expire.Label}">
                    <ComboBoxItem Content="{loc:Tr Expire.Never}"/>
                    <ComboBoxItem Content="{loc:Tr Expire.OneDay}"/>
                    <ComboBoxItem Content="{loc:Tr Expire.SevenDays}"/>
                    <ComboBoxItem Content="{loc:Tr Expire.Burn}"/>
                  </ComboBox>
                  <TextBox x:Name="EditorTags" Grid.Row="1" Grid.Column="2" Style="{StaticResource S.Input}" Padding="9,7" FontSize="{DynamicResource T.Font12}" VerticalContentAlignment="Center"
                           Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Tr Workbench.Tags.Placeholder}" AutomationProperties.Name="{loc:Tr Workbench.Tags}"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
            <!-- Wrapping preserves all commands at narrow sizes and in long translations. -->
            <WrapPanel x:Name="EditorActions" DockPanel.Dock="Bottom" Margin="0,12,-6,-6">
              <Button x:Name="UseTemplateButton" Style="{StaticResource S.Workbench.Button}" Margin="0,0,6,6"
                      Content="{loc:Tr Template.Use}" Command="{Binding UseTemplateCommand}"
                      Visibility="{Binding EditIsTemplate, Converter={StaticResource BoolToVis}}"/>
              <Button x:Name="SaveButton" Style="{StaticResource S.Workbench.PrimaryButton}" Margin="0,0,6,6" MinWidth="74"
                      Command="{Binding SaveCommand}" Content="{loc:Tr Workbench.Editor.Save}"/>
              <Button x:Name="DeleteButton" Style="{StaticResource S.Workbench.Button}" Margin="0,0,6,6"
                      Foreground="{DynamicResource B.Danger}" Command="{Binding DeleteCommand}" Content="{loc:Tr Workbench.Editor.Delete}"
                      Visibility="{Binding IsTrashView, Converter={StaticResource InvBoolToVis}}"/>
              <Button x:Name="RestoreButton" Style="{StaticResource S.Workbench.Button}" Margin="0,0,6,6"
                      Command="{Binding RestoreCommand}" Content="{loc:Tr Workbench.Restore}" Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}"/>
              <Button x:Name="DeleteForeverButton" Style="{StaticResource S.Workbench.Button}" Margin="0,0,6,6"
                      Foreground="{DynamicResource B.Danger}" Command="{Binding DeleteForeverCommand}" Content="{loc:Tr Workbench.DeleteForever}"
                      Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
            <StackPanel x:Name="EditorStatus" DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="●" FontSize="{DynamicResource T.Font9}" Foreground="{DynamicResource B.Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Tr Workbench.Editor.Unsaved}" Style="{StaticResource S.Workbench.Caption}"/>
              </StackPanel>
              <TextBlock Text="{loc:Tr Workbench.Editor.ExternalConflict}" Style="{StaticResource S.Workbench.Caption}" Foreground="{DynamicResource B.Danger}"
                         Visibility="{Binding HasExternalConflict, Converter={StaticResource BoolToVis}}"/>
              <TextBlock Text="{Binding SaveErrorMessage}" Style="{StaticResource S.Workbench.Caption}" Foreground="{DynamicResource B.Danger}"
                         Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel x:Name="ContentToolbar" Margin="0,0,0,8">
                <Button x:Name="TransformBtn" DockPanel.Dock="Right" Style="{StaticResource S.Workbench.Button}" Padding="8,4" MinHeight="28"
                        Click="OnTransformMenuClick" Content="{loc:Tr Workbench.Transform}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{loc:Tr Transform.Upper}" Command="{Binding TransformCommand}" CommandParameter="upper"/>
                      <MenuItem Header="{loc:Tr Transform.Lower}" Command="{Binding TransformCommand}" CommandParameter="lower"/>
                      <MenuItem Header="{loc:Tr Transform.Collapse}" Command="{Binding TransformCommand}" CommandParameter="collapse"/>
                      <MenuItem Header="{loc:Tr Transform.NoBreaks}" Command="{Binding TransformCommand}" CommandParameter="nolinebrk"/>
                      <Separator/>
                      <MenuItem Header="{loc:Tr Transform.Json}" Command="{Binding TransformCommand}" CommandParameter="json"/>
                      <MenuItem Header="{loc:Tr Transform.UrlEnc}" Command="{Binding TransformCommand}" CommandParameter="urlenc"/>
                      <MenuItem Header="{loc:Tr Transform.UrlDec}" Command="{Binding TransformCommand}" CommandParameter="urldec"/>
                      <MenuItem Header="{loc:Tr Transform.B64Enc}" Command="{Binding TransformCommand}" CommandParameter="b64enc"/>
                      <MenuItem Header="{loc:Tr Transform.B64Dec}" Command="{Binding TransformCommand}" CommandParameter="b64dec"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <TextBlock Text="{loc:Tr Workbench.Editor.Content}" Style="{StaticResource S.Workbench.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              </DockPanel>
              <TextBox x:Name="ContentEditor" Grid.Row="1" Style="{StaticResource S.Input}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource T.Font13}" Padding="12,10" AutomationProperties.Name="{loc:Tr Workbench.Editor.Content}"
                       Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Grid.Row="1" Text="{loc:Tr Workbench.Editor.Hint}" Margin="13,11"
                         Foreground="{DynamicResource B.InputTextMuted}" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource S.Workbench.Caption}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding EditContent}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
        </Border>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
