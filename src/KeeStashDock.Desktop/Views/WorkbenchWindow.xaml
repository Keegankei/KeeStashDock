<!-- Workbench ("expanded" state): sidebar navigation | card list | editor.
     Closing hides to tray (the app never exits from a window close). -->
<Window x:Class="KeeStashDock.Desktop.Views.WorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeeStashDock.Desktop.Localization"
        Title="{loc:Tr Workbench.Title}"
        Width="960" Height="620" MinWidth="720" MinHeight="480"
        xmlns:v="clr-namespace:KeeStashDock.Desktop.Views"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B.WindowBg}">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <v:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="208"/>
      <ColumnDefinition Width="310"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ Sidebar: virtual views + categories ============
         The sidebar sits in its own rounded surface so the three columns
         read as distinct zones (nav | list | editor). -->
    <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="10"
            Background="{DynamicResource B.PanelBg}"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
            Padding="8">
    <DockPanel>
      <!-- Group toolbox: add / import (.ksdgrp) / built-in presets.
           Presets open a code-built menu (same BAML-connect caveat). -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <Button Style="{StaticResource S.Button}" HorizontalAlignment="Stretch"
                Command="{Binding AddCategoryCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Tr Workbench.AddCategory}"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource S.Button}" HorizontalAlignment="Stretch"
                Margin="0,4,0,0" Click="OnImportGroupClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Tr Workbench.Category.Import}"/>
          </StackPanel>
        </Button>
        <Button x:Name="PresetsBtn" Style="{StaticResource S.Button}"
                HorizontalAlignment="Stretch" Margin="0,4,0,0"
                Click="OnPresetsClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Tr Workbench.Category.Presets}"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <!-- Right-click on a REAL category (Id > 0) opens rename/delete.
           The menu is built in code-behind: declaring a ContextMenu with
           Click handlers inside ItemContainerStyle makes the XAML compiler
           mis-assign BAML connection ids (InvalidCastException at load). -->
      <ListBox x:Name="NavList" ItemsSource="{Binding Nav}"
               SelectedItem="{Binding SelectedNav}"
               Background="Transparent" BorderThickness="0"
               MouseRightButtonUp="OnNavRightClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,6">
              <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                         FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource B.Accent}"/>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    </Border>

    <!-- ============ Middle: search + card list ============ -->
    <DockPanel Grid.Column="1" Margin="0,0,10,0">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <TextBox x:Name="SearchBox" Style="{StaticResource S.Input}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
        <TextBlock Text="{loc:Tr Workbench.Search.Placeholder}" Margin="12,8,0,0"
                   Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
        <Button Style="{StaticResource S.ButtonPrimary}" Margin="0,6,6,0"
                Command="{Binding NewSnippetCommand}"
                Content="{loc:Tr Workbench.NewSnippet}"/>
        <Button Style="{StaticResource S.IconButton}" Margin="0,6,6,0" Content="&#xE722;"
                Click="OnCaptureScreenshot" ToolTip="{loc:Tr Screenshot.Capture}"/>
        <!-- Trash-only bulk action -->
        <Button Style="{StaticResource S.Button}" Margin="0,6,0,0"
                Foreground="{DynamicResource B.Danger}"
                Command="{Binding EmptyTrashCommand}"
                Content="{loc:Tr Workbench.EmptyTrash}"
                Visibility="{Binding IsTrashView,
                             Converter={StaticResource BoolToVis}}"/>
      </StackPanel>

      <ListBox x:Name="ItemList" ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem, Mode=OneWay}"
               SelectionChanged="OnItemSelectionChanged"
               Background="Transparent" BorderThickness="0"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource S.Card}">
              <StackPanel>
                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <Image Source="{Binding Thumbnail}" Height="90" Stretch="Uniform" Margin="0,5,0,5"
                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Preview}" Margin="0,3,0,3" FontSize="12"
                           Foreground="{DynamicResource B.TextMuted}"
                           TextWrapping="Wrap" MaxHeight="40"/>
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource S.Badge}">
                    <TextBlock Text="{Binding TypeBadge}" FontSize="10"
                               Foreground="{DynamicResource B.Accent}"/>
                  </Border>
                  <TextBlock Text="{Binding RelativeTime}" FontSize="10" Margin="6,0,0,0"
                             Foreground="{DynamicResource B.TextMuted}"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- ============ Right: editor pane ============ -->
    <DockPanel Grid.Column="2">
      <Button DockPanel.Dock="Top" Style="{StaticResource S.Button}" Click="OnOpenImage" Margin="0,0,0,8"
              Visibility="{Binding SelectedItem.IsImage, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <Image Source="{Binding SelectedItem.Thumbnail}" Height="90" Stretch="Uniform"/>
          <TextBlock Text="{loc:Tr Screenshot.Open}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
      </Button>
      <!-- Title row -->
      <TextBox DockPanel.Dock="Top" Style="{StaticResource S.Input}"
               FontSize="15" FontWeight="SemiBold"
               Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{loc:Tr Workbench.Editor.TitlePlaceholder}"/>

      <!-- Expiry policy and tags -->
      <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{loc:Tr Expire.Label}" FontSize="12"
                   Foreground="{DynamicResource B.TextMuted}"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox Grid.Column="1" MinWidth="110" FontSize="12"
                  SelectedIndex="{Binding EditExpireIndex}">
          <ComboBoxItem Content="{loc:Tr Expire.Never}"/>
          <ComboBoxItem Content="{loc:Tr Expire.OneDay}"/>
          <ComboBoxItem Content="{loc:Tr Expire.SevenDays}"/>
          <ComboBoxItem Content="{loc:Tr Expire.Burn}"/>
        </ComboBox>
        <TextBlock Grid.Column="2" Text="{loc:Tr Workbench.Tags}" FontSize="12"
                   Foreground="{DynamicResource B.TextMuted}"
                   VerticalAlignment="Center" Margin="12,0,6,0"/>
        <TextBox Grid.Column="3" Style="{StaticResource S.Input}" FontSize="12"
                 Padding="8,4" VerticalContentAlignment="Center"
                 Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Tr Workbench.Tags.Placeholder}"/>
      </Grid>

      <!-- Action bar -->
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Style="{StaticResource S.ButtonPrimary}"
                Command="{Binding SaveCommand}" Content="{loc:Tr Workbench.Editor.Save}"/>
        <Button Style="{StaticResource S.Button}" Margin="6,0,0,0"
                Foreground="{DynamicResource B.Danger}"
                Command="{Binding DeleteCommand}" Content="{loc:Tr Workbench.Editor.Delete}"
                Visibility="{Binding IsTrashView, Converter={StaticResource InvBoolToVis}}"/>
        <Button Style="{StaticResource S.Button}" Margin="6,0,0,0"
                Command="{Binding RestoreCommand}" Content="{loc:Tr Workbench.Restore}"
                Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}"/>
        <Button Style="{StaticResource S.Button}" Margin="6,0,0,0"
                Foreground="{DynamicResource B.Danger}"
                Command="{Binding DeleteForeverCommand}"
                Content="{loc:Tr Workbench.DeleteForever}"
                Visibility="{Binding IsTrashView, Converter={StaticResource BoolToVis}}"/>

        <!-- Built-in text transform menu -->
        <Button x:Name="TransformBtn" Style="{StaticResource S.Button}" Margin="12,0,0,0"
                Click="OnTransformMenuClick" Content="{loc:Tr Workbench.Transform}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Tr Transform.Upper}"     Command="{Binding TransformCommand}" CommandParameter="upper"/>
              <MenuItem Header="{loc:Tr Transform.Lower}"     Command="{Binding TransformCommand}" CommandParameter="lower"/>
              <MenuItem Header="{loc:Tr Transform.Collapse}"  Command="{Binding TransformCommand}" CommandParameter="collapse"/>
              <MenuItem Header="{loc:Tr Transform.NoBreaks}"  Command="{Binding TransformCommand}" CommandParameter="nolinebrk"/>
              <Separator/>
              <MenuItem Header="{loc:Tr Transform.Json}"      Command="{Binding TransformCommand}" CommandParameter="json"/>
              <MenuItem Header="{loc:Tr Transform.UrlEnc}"    Command="{Binding TransformCommand}" CommandParameter="urlenc"/>
              <MenuItem Header="{loc:Tr Transform.UrlDec}"    Command="{Binding TransformCommand}" CommandParameter="urldec"/>
              <MenuItem Header="{loc:Tr Transform.B64Enc}"    Command="{Binding TransformCommand}" CommandParameter="b64enc"/>
              <MenuItem Header="{loc:Tr Transform.B64Dec}"    Command="{Binding TransformCommand}" CommandParameter="b64dec"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <TextBlock Text="●" FontSize="11"
                   Foreground="{DynamicResource B.TextMuted}"
                   ToolTip="{loc:Tr Workbench.Editor.UnsavedPrompt}"
                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{loc:Tr Workbench.Editor.ExternalConflict}" FontSize="11"
                   Foreground="{DynamicResource B.Danger}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasExternalConflict, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{Binding SaveErrorMessage}" FontSize="11"
                   Foreground="{DynamicResource B.Danger}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>

      <!-- Content editor -->
      <TextBox x:Name="ContentEditor" Style="{StaticResource S.Input}" Margin="0,8,0,0"
               AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" FontSize="13"
               Padding="10,8"
               FontFamily="{StaticResource F.UI}"
               Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>
  </Grid>
</Window>
