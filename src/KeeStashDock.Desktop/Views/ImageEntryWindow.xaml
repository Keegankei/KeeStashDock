<Window x:Class="KeeStashDock.Desktop.Views.ImageEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KeeStashDock.Desktop.Localization"
        Title="{loc:Tr Screenshot.Title}" Width="900" Height="620"
        MinWidth="640" MinHeight="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.WindowBg}">
  <Window.Resources>
    <Style x:Key="ImagePrimaryButton" TargetType="Button" BasedOn="{StaticResource S.ButtonPrimary}">
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource B.TextPrimary}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12">
      <Button Style="{StaticResource S.Button}" Content="{loc:Tr Screenshot.CopyImage}"
              Click="OnCopyImage" Margin="0,0,8,4"/>
      <Button Style="{StaticResource S.Button}" Content="{loc:Tr Screenshot.SaveImage}"
              Click="OnSaveImage" Margin="0,0,8,4"/>
      <Button x:Name="RecognizeButton" Style="{StaticResource ImagePrimaryButton}"
              Content="{loc:Tr Screenshot.Recognize}" Click="OnRecognize" Margin="0,0,8,4"/>
      <Button x:Name="CancelRecognitionButton" Style="{StaticResource S.Button}"
              Content="{loc:Tr Common.Cancel}" Click="OnCancelRecognition" Visibility="Collapsed"
              Margin="0,0,8,4"/>
    </WrapPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource B.PanelBg}" BorderBrush="{DynamicResource B.Border}"
              BorderThickness="1" CornerRadius="8" Padding="8">
        <Image x:Name="OriginalImage" Stretch="Uniform"/>
      </Border>
      <TextBox x:Name="OcrText" Grid.Column="2" Style="{StaticResource S.Input}"
               AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               TextChanged="OnTextChanged"/>
    </Grid>
    <TextBlock Grid.Row="2" Text="{loc:Tr Screenshot.OcrHint}" TextWrapping="Wrap"
               Margin="0,10,0,8" FontSize="{DynamicResource T.Font12}" Foreground="{DynamicResource B.TextMuted}"/>
    <DockPanel Grid.Row="3">
      <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button x:Name="CopyTextButton" Style="{StaticResource S.Button}" Content="{loc:Tr Screenshot.CopyText}"
                Click="OnCopyText" Margin="0,0,8,0"/>
        <Button x:Name="SaveTextButton" Style="{StaticResource ImagePrimaryButton}"
                Content="{loc:Tr Workbench.Editor.Save}" Click="OnSaveText"/>
      </WrapPanel>
      <TextBlock x:Name="Status" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                 Foreground="{DynamicResource B.TextMuted}"/>
    </DockPanel>
  </Grid>
</Window>
