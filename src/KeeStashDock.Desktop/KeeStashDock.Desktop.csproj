<!-- WPF host application.
     Windows Forms is enabled only for NotifyIcon; no third-party tray package
     is required because it ships with the Windows Desktop runtime. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>KeeStashDock.Desktop</RootNamespace>
    <AssemblyName>KeeStashDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The release profile bundles the .NET host while retaining editable
         locales, optional component tools, and documentation. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Implicit Windows Forms and Drawing global usings collide with WPF
         types. Remove them globally; the tray implementation uses aliases. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM source generators and dependency-injection composition. -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeeStashDock.Core\KeeStashDock.Core.csproj" />
    <ProjectReference Include="..\KeeStashDock.Infrastructure\KeeStashDock.Infrastructure.csproj" />
    <ProjectReference Include="..\KeeStashDock.Domain\KeeStashDock.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editable language packs are copied beside the executable for live reload. -->
    <None Include="Locales\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Setup is explicit; OCR never downloads models while recognizing an image. -->
    <None Include="..\..\tools\native-runtime\Setup.ps1" Link="NativeRuntime\Setup.ps1"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\tools\ocr\Setup.ps1" Link="OcrModels\Setup.ps1"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\docs\SCREENSHOTS.md" Link="Docs\Screenshots.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\docs\LOCAL_OCR.md" Link="OcrModels\README.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\third_party\dotnet\*" Link="Licenses\dotnet\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\third_party\qr\*" Link="Licenses\QR\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\third_party\ocr\*" Link="Licenses\OCR\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the project and dependency notices with every distributable build. -->
    <None Include="..\..\docs\UPDATING.md" Link="Docs\Updating.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\docs\UPDATING.zh-CN.md" Link="Docs\Updating.zh-CN.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\docs\GETTING_STARTED.md" Link="StartHere.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\LICENSE" Link="Licenses\LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\NOTICE" Link="Licenses\NOTICE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="Licenses\THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <!-- Optional engine setup is shipped as source; runtime/models are installed separately. -->
    <None Include="..\..\tools\offline-translation\*.ps1;..\..\tools\offline-translation\*.cmd;..\..\tools\offline-translation\*.py;..\..\tools\offline-translation\*.json;..\..\tools\offline-translation\*.txt"
          Exclude="..\..\tools\offline-translation\test_*.*"
          Link="OfflineTranslation\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="..\..\docs\OFFLINE_TRANSLATION.md" Link="OfflineTranslation\README.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <!-- Editable assets stay outside the host; optional OCR binaries and model
       caches are never part of a fresh release package. -->
  <Target Name="OrganizePortableBundle" BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'StartHere.md' Or $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^(x64|Locales|NativeRuntime|OcrModels|OfflineTranslation|Licenses|Docs)[\\/]'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb' Or ('$(RuntimeIdentifier)' == 'win-x64' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^x86[\\/]')))" />
    </ItemGroup>
  </Target>
</Project>
